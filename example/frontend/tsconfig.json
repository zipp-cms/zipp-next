{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"moduleDetection": "force",
		"strict": true,
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"]
}
