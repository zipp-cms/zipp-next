{
	"name": "zipp-forms",
	"version": "0.2.0",
	"description": "Crelte frontend of the zipp-forms plugin: load a form of the zipp studio, show it and send it. Svelte and TypeScript source, the site's vite builds it.",
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zipp-cms/zipp-next.git",
		"directory": "crates/zipp-forms/crelte"
	},
	"type": "module",
	"files": [
		"src",
		"tsconfig.json"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./server": {
			"types": "./src/server.ts",
			"default": "./src/server.ts"
		}
	},
	"peerDependencies": {
		"crelte": "^0.6.0-alpha.0",
		"svelte": "^5.0.0"
	}
}
